{
  "name": "nexora-ai",
  "version": "1.0.0",
  "description": "Nexora AI – Multi-Tenant WhatsApp AI Workforce Platform powered by Baileys and OpenClaw",
  "private": true,
  "type": "commonjs",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsx watch --exclude baileys_auth_info --exclude storage --exclude uploads --exclude web --exclude dist --exclude tests src/main.ts",
    "web:dev": "pnpm --dir web dev",
    "web:build": "pnpm --dir web build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "preview:email": "tsx scripts/preview-email.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/swagger": "^9.2.0",
    "@fastify/swagger-ui": "^5.0.1",
    "@hapi/boom": "^10.0.1",
    "@prisma/client": "^6.1.0",
    "@types/nodemailer": "^8.0.2",
    "@whiskeysockets/baileys": "^6.7.9",
    "bullmq": "^5.30.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.1.0",
    "imapflow": "^2.12.0",
    "ioredis": "^5.4.1",
    "nodemailer": "^10.6.0",
    "pdf-parse": "^1.1.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "playwright-core": "^1.65.1",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pdf-parse": "^1.1.4",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.5.13",
    "pnpm": "^9.15.0",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
