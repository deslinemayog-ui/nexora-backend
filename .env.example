# ============================================================================
# Nexora AI – Multi-Tenant WhatsApp AI Workforce Platform
# Environment Configuration (.env.example)
# ============================================================================

# Application Runtime
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# PostgreSQL Database (Prisma)
DATABASE_URL="postgresql://nexora:nexora_secret_password@localhost:5432/nexora_ai?schema=public"

# Redis (BullMQ Queues, Rate Limiting & Deduplication Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# OpenClaw Gateway Configuration (Default port: 18789)
# OpenClaw 2026.11+ serves both WebSocket RPC and HTTP APIs on port 18789
OPENCLAW_GATEWAY_WS_URL=ws://127.0.0.1:18789
OPENCLAW_GATEWAY_HTTP_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=replace_with_openclaw_gateway_shared_token
OPENCLAW_GATEWAY_PASSWORD=
OPENCLAW_DEFAULT_AGENT_ID=main
OPENCLAW_REQUEST_TIMEOUT_MS=60000
OPENCLAW_CLIENT_ID=nexora-orchestrator

# WhatsApp Gateway (Baileys)
WHATSAPP_PROVIDER=baileys
WHATSAPP_AUTH_DIR=./storage/whatsapp-auth
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_PRINT_QR=true
WHATSAPP_MAX_RECONNECT_ATTEMPTS=10
WHATSAPP_RECONNECT_BASE_DELAY_MS=2000
WHATSAPP_RATE_LIMIT_PER_MINUTE=30

# Document & Object Storage (S3-Compatible or Local Encrypted Storage)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage/documents
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=nexora-customer-documents
S3_ACCESS_KEY_ID=replace_with_s3_access_key
S3_SECRET_ACCESS_KEY=replace_with_s3_secret_key
S3_FORCE_PATH_STYLE=true

# Media & File Processing Limits
MAX_FILE_SIZE_BYTES=15728640
CLAMAV_ENABLED=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
STT_PROVIDER=openclaw
OCR_PROVIDER=openclaw

# Security & Encryption
# Must be a 64-character hex string (32 bytes) for AES-256-GCM encryption at rest
ENCRYPTION_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ADMIN_API_KEY=replace_with_strong_admin_api_key_min_32_chars
API_RATE_LIMIT_MAX=100
API_RATE_LIMIT_WINDOW_MS=60000
