generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
  DEACTIVATED
}

enum SubscriptionTier {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIALING
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VOICE_NOTE
  PDF
  DOCUMENT
  SYSTEM
}

enum DeliveryStatus {
  RECEIVED
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum ProjectStatus {
  PENDING
  PLANNING
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  AWAITING_APPROVAL
  COMPLETED
  FAILED
  CANCELLED
}

enum TaskStatus {
  PENDING
  PLANNING
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  AWAITING_APPROVAL
  COMPLETED
  FAILED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AgentType {
  JOB_AGENT
  VISA_AGENT
  INVESTOR_AGENT
  BUSINESS_AGENT
  EDUCATION_AGENT
  RESEARCH_AGENT
}

enum ExecutionStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  TIMEOUT
  CANCELLED
}

enum DocumentType {
  CV
  PASSPORT
  CERTIFICATE
  BUSINESS_PLAN
  COMPANY_REGISTRATION
  IMAGE
  PDF
  VOICE_NOTE
  AUDIO
  OTHER
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  EXECUTED
}

enum ActionCategory {
  SEND_EMAIL
  SUBMIT_JOB_APPLICATION
  CONTACT_INVESTOR
  SHARE_PERSONAL_DOCUMENT
  BOOK_APPOINTMENT
  MAKE_PAYMENT
  SUBMIT_OFFICIAL_FORM
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SUPPRESSED
}

model Customer {
  id                  String           @id @default(uuid())
  whatsappNumber      String           @unique
  whatsappJid         String           @unique
  displayName         String?
  preferredLanguage   String           @default("en")
  accountStatus       AccountStatus    @default(ACTIVE)
  consentGiven        Boolean          @default(false)
  consentTimestamp    DateTime?
  consentVersion      String?
  creditBalanceCents  Int              @default(500)
  executionPermissions Json            @default("{\"autoResearch\":true,\"autoDraft\":true,\"requireApprovalForExternal\":true}")
  lastActivityAt      DateTime         @default(now())
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  profile             CustomerProfile?
  subscription        Subscription?
  conversations       Conversation[]
  messages            Message[]
  projects            Project[]
  tasks               Task[]
  agentExecutions     AgentExecution[]
  documents           Document[]
  approvals           Approval[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  memories            CustomerMemory[]
  assignments         Assignment[]
  assessmentSessions  AssessmentSession[]
  assessmentTranscripts AssessmentTranscript[]
  vacancyApplications VacancyApplication[]
  interviews          Interview[]
  placements          Placement[]

  @@index([whatsappNumber])
  @@index([accountStatus])
  @@index([lastActivityAt])
}

model CustomerProfile {
  id                  String   @id @default(uuid())
  customerId          String   @unique
  fullName            String?
  email               String?
  countryOfResidence  String?
  nationality         String?
  targetCountries     String[] @default([])
  currentOccupation   String?
  yearsOfExperience   Int?
  educationSummary    Json?
  skills              String[] @default([])
  workExperience      Json?
  businessDetails     Json?
  preferences         Json     @default("{}")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  customer            Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model Subscription {
  id                  String             @id @default(uuid())
  customerId          String             @unique
  tier                SubscriptionTier   @default(FREE)
  status              SubscriptionStatus @default(ACTIVE)
  monthlyTaskQuota    Int                @default(25)
  tasksUsedThisPeriod Int                @default(0)
  currentPeriodStart  DateTime           @default(now())
  currentPeriodEnd    DateTime
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  customer            Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, status])
}

model Conversation {
  id                  String             @id @default(uuid())
  customerId          String
  openclawSessionKey  String             @unique
  status              ConversationStatus @default(ACTIVE)
  activeProjectId     String?
  summary             String?
  lastMessageAt       DateTime           @default(now())
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  customer            Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messages            Message[]

  @@index([customerId, status])
  @@index([lastMessageAt])
}

model Message {
  id                  String           @id @default(uuid())
  customerId          String
  conversationId      String
  externalMessageId   String?          @unique
  direction           MessageDirection
  messageType         MessageType      @default(TEXT)
  content             String
  mediaDocumentId     String?
  deliveryStatus      DeliveryStatus   @default(RECEIVED)
  detectedIntent      String?
  routedAgentType     AgentType?
  projectId           String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  customer            Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  conversation        Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  project             Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([customerId, conversationId, createdAt])
  @@index([externalMessageId])
}

model Project {
  id                     String        @id @default(uuid())
  customerId             String
  title                  String
  objective              String
  description            String
  assignedSpecialist     AgentType
  status                 ProjectStatus @default(PENDING)
  priority               Priority      @default(MEDIUM)
  expectedCompletionDate DateTime?
  executionHistory       Json          @default("[]")
  finalResults           Json?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  customer               Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tasks                  Task[]
  documents              Document[]
  approvals              Approval[]
  messages               Message[]
  agentExecutions        AgentExecution[]
  notifications          Notification[]

  @@index([customerId, status])
  @@index([customerId, updatedAt])
}

model Task {
  id                  String           @id @default(uuid())
  customerId          String
  projectId           String
  stepOrder           Int              @default(1)
  title               String
  description         String
  assignedSpecialist  AgentType
  status              TaskStatus       @default(PENDING)
  priority            Priority         @default(MEDIUM)
  requiresApproval    Boolean          @default(false)
  actionCategory      ActionCategory?
  inputPayload        Json?
  resultPayload       Json?
  errorMessage        String?
  retryCount          Int              @default(0)
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  customer            Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  project             Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  approvals           Approval[]
  agentExecutions     AgentExecution[]

  @@index([customerId, projectId, stepOrder])
  @@index([customerId, status])
}

model Agent {
  id                     String           @id @default(uuid())
  agentType              AgentType        @unique
  taskKey                String           @default("employment")
  name                   String
  description            String
  openclawAgentId        String
  allowedTools           String[]         @default([])
  restrictedActions      String[]         @default([])
  costPerSubmissionCents Int              @default(100)
  sortOrder              Int              @default(0)
  isActive               Boolean          @default(true)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  executions             AgentExecution[]
}

model AgentExecution {
  id                  String          @id @default(uuid())
  customerId          String
  agentId             String?
  agentType           AgentType
  projectId           String?
  taskId              String?
  openclawSessionKey  String
  openclawRunId       String?
  status              ExecutionStatus @default(QUEUED)
  promptSummary       String
  responseSummary     String?
  tokensUsed          Int             @default(0)
  toolCallsCount      Int             @default(0)
  durationMs          Int?
  errorMessage        String?
  startedAt           DateTime        @default(now())
  endedAt             DateTime?
  createdAt           DateTime        @default(now())

  customer            Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  agent               Agent?          @relation(fields: [agentId], references: [id], onDelete: SetNull)
  project             Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task                Task?           @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@index([openclawRunId])
  @@index([projectId, taskId])
}

model Document {
  id                  String       @id @default(uuid())
  customerId          String
  projectId           String?
  documentType        DocumentType
  originalFileName    String
  mimeType            String
  fileSizeBytes       Int
  storageKey          String       @unique
  encryptionIv        String
  encryptionAuthTag   String
  checksumSha256      String
  scanStatus          ScanStatus   @default(PENDING)
  extractedText       String?
  structuredMetadata  Json?
  isSensitive         Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  customer            Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  project             Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([customerId, documentType])
  @@index([customerId, projectId])
}

model Approval {
  id                  String         @id @default(uuid())
  customerId          String
  projectId           String?
  taskId              String?
  actionCategory      ActionCategory
  title               String
  description         String
  actionPayload       Json
  status              ApprovalStatus @default(PENDING)
  requestedAt         DateTime       @default(now())
  respondedAt         DateTime?
  customerResponseRaw String?
  executedAt          DateTime?
  executionResult     Json?
  expiresAt           DateTime

  customer            Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  project             Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task                Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([customerId, status])
  @@index([projectId, taskId])
}

model AuditLog {
  id                  String   @id @default(uuid())
  customerId          String?
  actorType           String
  actorId             String
  action              String
  resourceType        String
  resourceId          String?
  details             Json
  ipAddress           String?
  createdAt           DateTime @default(now())

  customer            Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@index([action, createdAt])
}

model Notification {
  id                  String             @id @default(uuid())
  customerId          String?
  organisationId      String?
  projectId           String?
  type                String             @default("GENERAL")
  title               String
  message             String
  actionUrl           String?
  isRead              Boolean            @default(false)
  status              NotificationStatus @default(PENDING)
  sentAt              DateTime?
  errorMessage        String?
  createdAt           DateTime           @default(now())

  customer            Customer?          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  organisation        Organisation?      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project             Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([customerId, status, isRead])
  @@index([organisationId, isRead])
}

model CustomerMemory {
  id                  String   @id @default(uuid())
  customerId          String
  category            String
  key                 String
  value               String
  confidence          Float    @default(1.0)
  sourceMessageId     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  customer            Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, category, key])
  @@index([customerId, category])
}

// ==================== PHASE 1-5: RECRUITMENT, ASSESSMENTS, PORTALS & STAFFING ====================

enum OrganisationCategory {
  HIRING_COMPANY
  RECRUITMENT_AGENCY
  STAFFING_COMPANY
  INVESTMENT_PROVIDER
  RELOCATION_AGENCY
  IMMIGRATION_CONSULTANCY
  SCHOLARSHIP_PROVIDER
  EDUCATIONAL_INSTITUTION
  OTHER_PROVIDER
}

enum OrganisationStatus {
  PENDING_APPROVAL
  VERIFIED
  SUSPENDED
  REJECTED
}

enum VacancyCategory {
  EMPLOYMENT
  RELOCATION
  SCHOLARSHIP
  INVESTMENT
}

enum VacancyType {
  PERMANENT
  TEMPORARY
  CONTRACT
  PART_TIME
  FULL_TIME
  REMOTE
}

enum WorkArrangement {
  REMOTE
  HYBRID
  ON_SITE
}

enum VacancyStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  CLOSED
}

enum AssignmentCategory {
  EMPLOYMENT
  RELOCATION
  SCHOLARSHIP
}

enum AssignmentStatus {
  NOT_STARTED
  PREREQUISITES_REQUIRED
  READY_TO_START
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  PASSED
  FAILED
  EXPIRED
}

enum DifficultyLevel {
  INTERMEDIATE
  ADVANCED
  HARD
}

enum ApplicationStatus {
  RECEIVED
  SCREENING
  SHORTLISTED
  INTERVIEW_SCHEDULED
  INTERVIEWED
  OFFER_MADE
  HIRED
  REJECTED
  WITHDRAWN
}

enum InterviewType {
  ONLINE
  TELEPHONE
  IN_PERSON
}

enum InterviewStatus {
  INVITED
  SCHEDULED
  RESCHEDULED
  COMPLETED
  CANCELLED
}

enum ContractModel {
  DIRECT_PLACEMENT
  CONTRACTOR_PLACEMENT
  NEXORA_EOR_STAFFING
}

model Organisation {
  id                     String               @id @default(uuid())
  registeredName         String
  tradingName            String?
  registrationNumber     String?
  country                String
  businessAddress        String
  website                String?
  description            String
  category               OrganisationCategory
  contactFullName        String
  contactPosition        String
  businessEmail          String               @unique
  passwordHash           String
  telephone              String
  generalEmail           String?
  recruitmentEmail       String
  interviewEmail         String?
  billingEmail           String?
  additionalRecipients   String[]             @default([])
  emailVerified          Boolean              @default(false)
  verificationToken      String?
  verificationDocs       Json                 @default("[]")
  status                 OrganisationStatus   @default(PENDING_APPROVAL)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  vacancies              Vacancy[]
  applications           VacancyApplication[]
  interviews             Interview[]
  notifications          Notification[]
  placements             Placement[]

  @@index([businessEmail])
  @@index([category, status])
}

model Vacancy {
  id                    String           @id @default(uuid())
  organisationId        String
  title                 String
  category              VacancyCategory  @default(EMPLOYMENT)
  vacancyType           VacancyType      @default(FULL_TIME)
  workArrangement       WorkArrangement  @default(REMOTE)
  location              String
  salaryRange           String?
  description           String
  requirements          String
  qualifications        String?
  minYearsExperience    Int              @default(0)
  requiredSkills        String[]         @default([])
  requiresAssessment    Boolean          @default(true)
  passingScorePercent   Int              @default(70)
  assessmentDurationMin Int              @default(25)
  applicationDeadline   DateTime?
  status                VacancyStatus    @default(DRAFT)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  organisation          Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  assignments           Assignment[]
  applications          VacancyApplication[]
  interviews            Interview[]
  placements            Placement[]

  @@index([organisationId, status])
  @@index([category, status])
}

model Assignment {
  id                   String             @id @default(uuid())
  customerId           String
  vacancyId            String?
  title                String
  category             AssignmentCategory
  relatedOpportunity   String
  providerName         String?
  durationMinutes      Int                @default(25)
  passingScorePercent  Int                @default(70)
  status               AssignmentStatus   @default(NOT_STARTED)
  prerequisiteData     Json?
  prerequisitesMet     Boolean            @default(false)
  missingPrerequisites String[]           @default([])
  dueDate              DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  customer             Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vacancy              Vacancy?           @relation(fields: [vacancyId], references: [id], onDelete: SetNull)
  sessions             AssessmentSession[]
  transcripts          AssessmentTranscript[]

  @@index([customerId, category, status])
}

model AssessmentSession {
  id                 String               @id @default(uuid())
  assignmentId       String
  customerId         String
  rulesAccepted      Boolean              @default(false)
  startedAt          DateTime?
  expiresAt          DateTime?
  submittedAt        DateTime?
  durationSeconds    Int?
  totalQuestions     Int                  @default(15)
  correctCount       Int                  @default(0)
  incorrectCount     Int                  @default(0)
  percentageScore    Float                @default(0)
  passed             Boolean              @default(false)
  isCompleted        Boolean              @default(false)
  topicBreakdown     Json                 @default("{}")
  difficultyBreakdown Json                @default("{}")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  assignment         Assignment           @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  customer           Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  questions          AssessmentQuestion[]
  answers            AssessmentAnswer[]
  transcript         AssessmentTranscript?

  @@index([assignmentId, customerId])
}

model AssessmentQuestion {
  id             String          @id @default(uuid())
  sessionId      String
  questionOrder  Int
  statement      String
  options        String[]
  correctIndex   Int
  difficulty     DifficultyLevel
  topic          String
  explanation    String
  allocatedSec   Int             @default(90)
  createdAt      DateTime        @default(now())

  session        AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  answers        AssessmentAnswer[]

  @@index([sessionId, questionOrder])
}

model AssessmentAnswer {
  id             String             @id @default(uuid())
  sessionId      String
  questionId     String
  selectedIndex  Int
  isCorrect      Boolean            @default(false)
  timeSpentSec   Int                @default(0)
  answeredAt     DateTime           @default(now())

  session        AssessmentSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question       AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionId])
}

model AssessmentTranscript {
  id                   String            @id @default(uuid())
  customerId           String
  assignmentId         String
  sessionId            String            @unique
  cvDocumentId         String?
  cvFileName           String?
  candidateName        String
  candidateEmail       String?
  assignmentTitle      String
  category             AssignmentCategory
  totalQuestions       Int
  correctCount         Int
  percentageScore      Float
  passed               Boolean
  totalDurationSec     Int
  topicBreakdown       Json
  difficultyBreakdown  Json
  questionDetails      Json
  aiPerformanceSummary String
  pdfFileName          String?
  pdfDownloadUrl       String?
  submittedAt          DateTime          @default(now())
  createdAt            DateTime          @default(now())

  customer             Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignment           Assignment        @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  session              AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
}

model VacancyApplication {
  id                  String            @id @default(uuid())
  referenceCode       String            @unique
  vacancyId           String
  organisationId      String
  customerId          String
  candidateName       String
  candidateEmail      String
  candidatePhone      String?
  cvFileName          String?
  cvDownloadUrl       String?
  transcriptId        String?
  transcriptScore     Float?
  qualifications      String?
  workExperience      String?
  skills              String[]          @default([])
  coverNote           String?
  consentToShare      Boolean           @default(true)
  status              ApplicationStatus @default(RECEIVED)
  internalNotes       String?
  aiMatchSummary      String?
  aiMatchScore        Int?
  appliedAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  vacancy             Vacancy           @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  organisation        Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  customer            Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  interviews          Interview[]

  @@index([organisationId, status])
  @@index([customerId, appliedAt])
}

model Interview {
  id                   String          @id @default(uuid())
  organisationId       String
  vacancyId            String?
  applicationId        String?
  customerId           String
  companyName          String
  jobTitle             String
  candidateName        String
  candidateEmail       String
  interviewDate        String
  interviewTime        String
  timezone             String          @default("UTC")
  interviewType        InterviewType   @default(ONLINE)
  locationOrLink       String
  instructions         String?
  status               InterviewStatus @default(SCHEDULED)
  interviewerNotes     String?
  candidateFeedback    String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  organisation         Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  vacancy              Vacancy?           @relation(fields: [vacancyId], references: [id], onDelete: SetNull)
  application          VacancyApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  customer             Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, status])
  @@index([organisationId, status])
}

model Placement {
  id                   String        @id @default(uuid())
  organisationId       String
  vacancyId            String?
  customerId           String
  candidateName        String
  roleTitle            String
  contractModel        ContractModel @default(DIRECT_PLACEMENT)
  startDate            String
  endDate              String?
  hourlyRateCents      Int?
  monthlySalaryCents   Int?
  placementFeeCents    Int?
  currency             String        @default("USD")
  legalEntityArranged  Boolean       @default(false)
  taxComplianceReady   Boolean       @default(false)
  onboardingStatus     String        @default("ONBOARDING")
  contractTerms        String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  organisation         Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  vacancy              Vacancy?      @relation(fields: [vacancyId], references: [id], onDelete: SetNull)
  customer             Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  timesheets           Timesheet[]
  payrollRecords       PayrollRecord[]

  @@index([organisationId])
  @@index([customerId])
}

model Timesheet {
  id            String    @id @default(uuid())
  placementId   String
  weekStarting  String
  hoursWorked   Float
  attendanceLog String?
  approved      Boolean   @default(false)
  invoiced      Boolean   @default(false)
  invoiceAmountCents Int?
  createdAt     DateTime  @default(now())

  placement     Placement @relation(fields: [placementId], references: [id], onDelete: Cascade)

  @@index([placementId])
}

model PayrollRecord {
  id              String    @id @default(uuid())
  placementId     String
  periodLabel     String
  grossPayCents   Int
  deductionsCents Int       @default(0)
  netPayCents     Int
  status          String    @default("DRAFT_PENDING_COMPLIANCE")
  payslipUrl      String?
  createdAt       DateTime  @default(now())

  placement       Placement @relation(fields: [placementId], references: [id], onDelete: Cascade)

  @@index([placementId])
}
